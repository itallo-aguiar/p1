# Gemini API Key (Server-side medical question generation & clinical preceptor)
GEMINI_API_KEY=

# Supabase Auth & Profile Sync (Optional - fallback localStorage mode active if not set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Server Port (Default: 3000)
PORT=3000
